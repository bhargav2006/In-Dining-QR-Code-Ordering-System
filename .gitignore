# ==========================================
# Root .gitignore - Restaurant QR Ordering System
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Settings
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.next/
.out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secret Files (Keep .env.example)
.env
*.env
backend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Java / Maven / Backend Build Outputs
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.rar

# Maven Wrapper Temp Files
.mvn/wrapper/maven-wrapper.jar

# Temporary & Crash Dumps
*.tmp
*.bak
*.dump

.playwright-mcp/